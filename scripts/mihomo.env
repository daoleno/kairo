# The mihomo core Kairo ships: one official MetaCubeX/mihomo release, pinned,
# with the SHA-256 GitHub publishes for each build. Change all of these
# together (scripts/fetch-mihomo.sh checks them).
MIHOMO_VERSION=v1.19.33
MIHOMO_LINUX_X86_64=mihomo-linux-amd64-compatible
MIHOMO_LINUX_X86_64_SHA256=386508bfb1c72c43b6a0eda73708ecdce82546581b0ebcb16366c53757c622b6
MIHOMO_LINUX_AARCH64=mihomo-linux-arm64
MIHOMO_LINUX_AARCH64_SHA256=ba408b317080ee265c46cb923a50018c1b82cbd708551cdd46a1e3e307396187
MIHOMO_DARWIN_AARCH64=mihomo-darwin-arm64
MIHOMO_DARWIN_AARCH64_SHA256=060b64b0f2c9a310831db0fe4adb2878de67bfa606c311813c1f13966aa504b6
MIHOMO_DARWIN_X86_64=mihomo-darwin-amd64-compatible
MIHOMO_DARWIN_X86_64_SHA256=eefe967b74312f70b64efa0dfa54929d00c7af8e94416e1b12df09863a40f35b
