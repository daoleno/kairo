[Unit]
Description=Kairo (the proxy, and its page)
Documentation=https://github.com/daoleno/kairo
# No network-online.target: a user unit cannot order itself after it (it is
# the system manager's). Nothing waits for the network: a --listen address
# that is not up yet is bound anyway (Linux) or tried again every 10 s, and
# the proxy runs meanwhile.

[Service]
# Other addresses: add --listen ADDR with --tls-cert FILE --tls-key FILE
# (plain HTTP beyond loopback opens only with --insecure-http). Read
# SECURITY-NOTES.md first.
ExecStart=@BIN@ serve
# Always: an update ends the server so that this starts the new one.
Restart=always
RestartSec=2
UMask=0077
# No NoNewPrivileges=: the core's TUN permission is a file capability, which
# a process under no_new_privs does not get.

[Install]
WantedBy=default.target
